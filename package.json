{
  "name": "obsidian-outliner",
  "version": "4.10.3",
  "description": "Work with your lists like in Workflowy or RoamResearch.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.mjs -w --configWithTests",
    "build-with-tests": "rollup --config rollup.config.mjs --configWithTests",
    "build": "rollup --config rollup.config.mjs",
    "lint": "prettier --check src && eslint src",
    "test": "jest --forceExit",
    "test:unit": "SKIP_OBSIDIAN=1 jest --forceExit src",
    "test:release": "node --test scripts/release.test.mjs",
    "prepare": "husky"
  },
  "author": "Viacheslav Slinko",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "babel-jest": "^30.5.2",
    "classic-level": "^3.0.0",
    "debug": "^4.4.3",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "inquirer": "^14.2.5",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "rollup": "^4.67.5",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "ws": "^8.22.1"
  }
}
