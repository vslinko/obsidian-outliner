{
  "compilerOptions": {
    "rootDir": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es6",
    "allowJs": true,
    "strict": false,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "types": ["node", "jest"],
    "importHelpers": true,
    "lib": ["dom", "es5", "scripthost", "es2015"],
    "outDir": "dist",
  },
  "include": ["jest/**/*.ts", "src/**/*.ts"],
}
